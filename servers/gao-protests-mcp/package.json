{
  "name": "gao-protests-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server on Cloudflare Workers and R2 for searching and comparing GAO bid protest decisions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
