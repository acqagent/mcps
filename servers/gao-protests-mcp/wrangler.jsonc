{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gao-protests-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],

  // Bundle written by scripts/build_bundle.py, uploaded to the bucket root.
  "r2_buckets": [{ "binding": "GAO_DATA", "bucket_name": "gao-protests" }],

  // Embeds free-text queries for search_decisions (@cf/baai/bge-base-en-v1.5, mean pooling).
  "ai": { "binding": "AI" },

  "vars": {
    // R2 key prefix of the bundle to serve; matches build_bundle.py --data-version.
    "DATA_VERSION": "v1"
  },

  // Per-client-IP limit on /mcp; requests over it get HTTP 429. period is 10 or 60 seconds, and
  // namespace_id is any number unique within your Cloudflare account. Remove it for no limit.
  "ratelimits": [{ "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],

  // Optional: `wrangler secret put MCP_AUTH_TOKEN` to require a bearer token on /mcp.
  // Optional: `wrangler secret put OPENAI_APPS_CHALLENGE` to verify the domain for OpenAI's plugin directory.

  // Keep the workers.dev URL when deploying with --domain (custom domains turn it off by default).
  "workers_dev": true,

  "observability": { "enabled": true }
}
